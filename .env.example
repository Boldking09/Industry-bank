# Industry Bank — Supabase configuration
#
# Copy this file to `.env` and fill in the two values from your project:
#   Supabase Dashboard → Project Settings → API
#
# VITE_ prefix is required so Vite exposes the value to the browser.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"
